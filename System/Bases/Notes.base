filters:
  and:
    - file.inFolder("Notes")
    - file.ext == "md"
    - note.type == "note"
properties:
  file.name:
    displayName: Note
  note.status:
    displayName: Status
  note.date:
    displayName: Date
  note.projects:
    displayName: Projects
  note.applications:
    displayName: Applications
  file.mtime:
    displayName: Last Updated
views:
  - type: table
    name: All Notes
    order:
      - file.name
      - date
      - projects
      - applications
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
  - type: table
    name: Unlinked Notes
    filters: (!note.projects || note.projects.length == 0) && (!note.applications || note.applications.length == 0)
    order:
      - file.name
      - date
      - projects
      - applications
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
